[
{
        "arguments": {
            "dragenGermline.outputFileNamePrefix": "Test-Sample",
            "dragenGermline.reference": "hg38",
            "dragenGermline.sampleInputs": [
                {
                    "fastqR1": {
                        "contents": {
                            "configuration": "/.mounts/labs/gsi/testdata/dragenGermline/test_inputs/Test_R1.fastq.gz",
                            "externalIds": [
                                {
                                    "id": "TEST",
                                    "provider": "TEST"
                                }
                            ]
                        },
                        "type": "EXTERNAL"
                    },
                    "fastqR2": {
                        "contents": {
                            "configuration": "/.mounts/labs/gsi/testdata/dragenGermline/test_inputs/Test_R2.fastq.gz",
                            "externalIds": [
                                {
                                    "id": "TEST",
                                    "provider": "TEST"
                                }
                            ]
                        },
                        "type": "EXTERNAL"
                    },
                    "readGroup": "ID:Test PL:Illumina PU:Test-01 LB:Test-01 SM:Test-01 CM:OICR"
                }
            ],
            "dragenGermline.composeList.jobMemory": null,
            "dragenGermline.composeList.timeout": null,
            "dragenGermline.extractInfoLine.jobMemory": null,
            "dragenGermline.extractInfoLine.timeout": null,
            "dragenGermline.runDragenGermline.enableDupMarking": null,
            "dragenGermline.runDragenGermline.enableTargeted": null,
            "dragenGermline.runDragenGermline.additionalParameters": null,
            "dragenGermline.runDragenGermline.timeout": null
        },
        "description": "Runs on downsampled data (DRAGEN testing dataset, Illumina), outputs vcf files in Germline mode.",
        "engineArguments": {
            "write_to_cache": false,
            "read_from_cache": false
        },
        "id": "Test_germline",
        "metadata": {
            "dragenGermline.unfilteredVcf": {
                "contents": [
                    {
                        "outputDirectory": "@SCRATCH@/@DATE@_Workflow_dragenGermline_Test_germline_@JENKINSID@"
                    }
                ],
                "type": "ALL"
            },
            "dragenGermline.filteredVcf": {
                "contents": [
                    {
                        "outputDirectory": "@SCRATCH@/@DATE@_Workflow_dragenGermline_Test_germline_@JENKINSID@"
                    }
                ],
                "type": "ALL"
            },
            "dragenGermline.targetedVcf": {
                "contents": [
                    {
                        "outputDirectory": "@SCRATCH@/@DATE@_Workflow_dragenGermline_Test_germline_@JENKINSID@"
                    }
                ],
                "type": "ALL"
            },
            "dragenGermline.ploidyVcf": {
                "contents": [
                    {
                        "outputDirectory": "@SCRATCH@/@DATE@_Workflow_dragenGermline_Test_germline_@JENKINSID@"
                    }
                ],
                "type": "ALL"
            }
        },
        "validators": [
            {
                "metrics_calculate": "@CHECKOUT@/tests/calculate.sh",
                "metrics_compare": "@CHECKOUT@/tests/compare.sh",
                "output_metrics": "/.mounts/labs/gsi/testdata/dragenGermline/output_metrics/workflow_test_01.metrics",
                "type": "script"
            }
        ]
    }
]
